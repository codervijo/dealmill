# Dealmill — owner-tunable constants. Copy to `.env` and fill in.
# `.env` is gitignored. Loaded via python-dotenv at CLI startup.

# Required for v2.A (Claude motivation scorer).
ANTHROPIC_API_KEY=

# Email transport for v4.A. Set EITHER SendGrid OR SMTP, not both.
SENDGRID_API_KEY=
# --- OR ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Where the daily digest is sent.
ALERT_EMAIL=

# Twilio (v4.B; optional). Only set if you want SMS for top-score listings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ALERT_PHONE=

# Scrape targeting.
TARGET_METROS=Salinas,Monterey,San Jose,Fresno,Sacramento
TARGET_CATEGORIES=laundromat,car_wash,self_storage,smb,commercial_re
MAX_ASKING_PRICE=500000

# Alert thresholds (v4.A and v4.B).
MIN_SCORE_ALERT=7
MIN_SCORE_INSTANT=8

# Cookie files for Akamai/login-walled sources. Run `make refresh-cookies` on
# the HOST (uses uv to invoke scripts/refresh_cookies.py with browser-cookie3)
# after logging into each site in Chrome. Paths are relative to the project root.
BBS_COOKIES_FILE=cookies/bizbuysell.json
LOOPNET_COOKIES_FILE=cookies/loopnet.json
FB_COOKIES_FILE=cookies/facebook.json
CREXI_COOKIES_FILE=cookies/crexi.json
